# Biassemble Backend — Environment Variables (server-only)
# Copy to .env.local for local development.

# Supabase Postgres
DATABASE_URL=

# Inngest (background jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI: dev-mock (local, no Core) | core (production → private AI Core service)
AI_CLIENT_MODE=dev-mock
# For local core-mode testing: biassemble-core's own local dev server, NOT a guessed port.
# Confirmed 2026-08-11: this has been mistakenly set to an unrelated local project's port
# before (a different app happened to be listening there) — check what biassemble-core's
# own `pnpm dev` actually binds to on your machine (e.g. `lsof -i -P | grep LISTEN` while it's
# running) rather than assuming a fixed port number here.
AI_CORE_BASE_URL=
AI_CORE_API_KEY=

# Optional: frontend origin in dev
CORS_ORIGIN=http://localhost:5173

# Prompts and LLM keys live in biassemble-core (private repo) — not here.
